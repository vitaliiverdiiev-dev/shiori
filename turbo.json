{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["product.config.json", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "API_URL"]
    }
  }
}
