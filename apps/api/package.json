{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts --host 127.0.0.1 --port 4983",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
