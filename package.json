{
  "name": "shiori",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-setup.mjs && turbo run dev",
    "dev:apps": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint scripts && turbo run lint",
    "test": "python3 -B -m unittest discover -s scripts && node --test \"scripts/*.test.mjs\" && turbo run test",
    "test:db": "pnpm --filter api test:db",
    "build-storybook": "turbo run build-storybook",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review:zip": "python3 scripts/review_zip.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
