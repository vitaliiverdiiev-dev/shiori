# Local development only. Copy to `.env` (git-ignored); these values are fake.
POSTGRES_USER=shiori
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=shiori
POSTGRES_PORT=55432

DATABASE_URL=postgres://shiori:local-dev-only-change-me@127.0.0.1:55432/shiori
TEST_DATABASE_URL=postgres://shiori:local-dev-only-change-me@127.0.0.1:55432/shiori_test

# Better Auth. The secret signs session cookies: outside localhost use a fresh
# random value of 32+ characters (e.g. `openssl rand -base64 32`); the API
# refuses this example secret and non-https URLs on any non-local host.
BETTER_AUTH_SECRET=local-dev-only-better-auth-secret-change-me
# Public origin the browser uses; in development the web app proxies /api.
BETTER_AUTH_URL=http://localhost:5173
# closed (default): no sign-up. `open` is rejected until email verification exists.
# REGISTRATION_MODE=closed

# API port (default 3000)
# PORT=3000
